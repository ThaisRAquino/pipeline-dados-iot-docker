# Copie este arquivo para ".env" antes de subir o ambiente local com Docker Compose.
# Nenhum valor real de produção deve estar aqui (12-Factor App: III - Config).

# --- Banco de dados ---
POSTGRES_DB=pedidos_veloz
POSTGRES_USER=pedidos_app
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=5432

# --- Serviço de Pagamentos (simulação) ---
TAXA_RECUSA_PAGAMENTO=0.1
LATENCIA_MIN_MS=100
LATENCIA_MAX_MS=400

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
NODE_ENV=development
